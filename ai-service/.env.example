# =====================================================================
# FactoryGuard AI Service — environment variables
# Copy to .env and fill in real values. Never commit .env.
# =====================================================================

# ---------- LLM ----------
# Provider switch: "ollama" (local dev) | "openai" (production / demo swap)
LLM_PROVIDER=ollama

# Ollama runtime
OLLAMA_BASE_URL=http://localhost:11434
# Dev box uses qwen2.5:3b for KPI runs (qwen3.5:9b was too slow on this
# hardware). Both share the /no_think prefix quirk — see
# project_qwen3_no_think memory.
OLLAMA_MODEL=qwen2.5:3b
# Keep the embedding/LLM models loaded so the first request after a
# quiet period doesn't pay the model-load cost (drops latency P95).
# This is read by the Ollama server process, not the client — set it in
# the environment that launches `ollama serve`.
# OLLAMA_KEEP_ALIVE=24h

# OpenAI runtime (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Embeddings ----------
# Provider switch: "ollama" | "openai"
EMBEDDING_PROVIDER=ollama
# nomic-embed-text (768d) replaced bge-m3 (1024d) after a reproducible
# Ollama NaN failure on plain English input. Do not revert without
# confirming the upstream fix — see project_embedding_model_swap memory.
EMBEDDING_MODEL=nomic-embed-text
# OpenAI embedding model (used when EMBEDDING_PROVIDER=openai)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Database (pgvector) ----------
# Default targets the compose db (ankane/pgvector:latest, PG15) bound
# to host port 5433. Backend owner locked smart_factory / ax_user on
# 2026-05-09. The legacy host PG17 `factoryguard` DB on :5432 is kept
# only for backup.
DATABASE_URL=postgresql+psycopg://ax_user:9ASs4xPr0j3Ct@localhost:5433/smart_factory

# ---------- Server ----------
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# ---------- Pipeline (Phase 6 — production defaults) ----------
# v2 = structure-aware chunking + hybrid retrieval (BM25 + Vector + RRF
# + bge-reranker-base). Real-manual eval Top-3 100% (25/25).
# v1 kept only for A/B comparison; manual_chunks (v1) is no longer
# populated in the current corpus.
PIPELINE_VERSION=v2
CHUNKING_STRATEGY=v2
