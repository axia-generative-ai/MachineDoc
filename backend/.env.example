# backend/.env.example — copy to backend/.env and fill in real values.
# .env is gitignored; this template documents required variables.

# Postgres (compose maps host 5433 -> container 5432)
DATABASE_URL=postgresql://ax_user:CHANGE_ME@localhost:5433/smart_factory

# JWT signing — production MUST rotate this. 32+ random bytes recommended.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-32+byte-random-string-do-not-ship-default
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_ENV=development

# ai-service location. Inside docker-compose, override to:
#   AI_SERVICE_URL=http://smart_factory_ai:8001
AI_SERVICE_URL=http://localhost:8001

# OpenAI is consumed only when ai-service routes through OpenAI provider.
# Backend itself does not call OpenAI directly.
OPENAI_API_KEY=sk-placeholder-not-used-by-backend
